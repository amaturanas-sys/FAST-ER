{
  "name": "FAST-E.R. — Gestor de Fichas Clínicas",
  "short_name": "FAST-E.R.",
  "description": "Herramienta offline para redactar y generar fichas clínicas (ingreso, evolución, epicrisis) en formato .docx.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f9f9f9",
  "theme_color": "#208096",
  "icons": [
